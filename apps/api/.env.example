# Purpose: API env variables template
# Copy karke `.env` banao — asli keys kabhi git me nahi jaani chahiye.

NODE_ENV=development
PORT=4000
# Public site (CORS + QR ke andar return url)
PUBLIC_WEB_URL=http://localhost:3000

# Postgres (docker compose se: postgres://youpi:youpi@localhost:5432/youpi)
DATABASE_URL=postgres://youpi:youpi@localhost:5432/youpi

# ---------------------------------------------------------------------------
# Razorpay — test keys se hi shuru karo (rzp_test_...), live tabhi jab KYC done ho
# Dashboard → Account & Settings → API Keys / Webhooks
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret — dashboard me webhook banate waqt jo secret set karte ho WAHI.
# Ye key secret NAHI hai. Signature isi se verify hota hai.
RAZORPAY_WEBHOOK_SECRET=

# Ek payment attempt kitni der zinda rahe (seconds). UPI QR isi ke baad expire.
PAYMENT_TTL_SECONDS=300

# Optional: sirf load test ke liye. Isse order/QR ka koi asli call nahi jaata.
PAYMENTS_DRY_RUN=false
