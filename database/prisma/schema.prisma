// Purpose: Poora DB schema (tables, relations). Paisa integer paise me
//
// Ye self-hosted YouPI gateway ka schema hai — koi payment aggregator nahi:
//   MerchantAccount (merchant ka apna VPA) → Order → PaymentSession (single-use UPI QR)
//   BankObservation (SMS/Gmail/Messages se aayi credit entry) → match → SUCCESS
//   OutboundWebhook (merchant ke server ko signed delivery, retries ke saath)
//
// Paisa har jagah integer paise. Kabhi float nahi.

generator client {
  provider = "prisma-client-js"
  // Vercel/serverless (Amazon Linux 2023) ke liye engine — local `native` bhi rakhna zaroori
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Merchant — paisa isi ke apne bank account (VPA) me jaata hai
// ---------------------------------------------------------------------------

model MerchantAccount {
  id                  String   @id @default(cuid())
  name                String
  /// UPI VPA jahan buyer pay karega, e.g. `store@okhdfcbank`
  vpa                 String   @unique
  /// QR me dikhne wala payee naam (bank app me yahi naam dikhta hai)
  payeeName           String
  /// UPI `mc` merchant code (bank/PSP se mila ho to) — UPI intent me jaata hai
  merchantCode        String?
  /// Merchant ke server ka webhook URL (signed delivery yahan jaati hai)
  webhookUrl          String?
  /// HMAC secret (merchant ke server ke saath shared). Sirf hash nahi — verify karna hai.
  webhookSecret       String?
  payWindowSeconds    Int      @default(300) // 5 minute pay window
  verifyWindowSeconds Int      @default(30) // 30 second verification window
  /// Ek VPA par ek hi ACTIVE slot (FIFO queue baaki buyers ke liye)
  slotConcurrency     Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  sessions  PaymentSession[]
  deliveries OutboundWebhook[]
}

// ---------------------------------------------------------------------------
// Catalog + orders
// ---------------------------------------------------------------------------

model Product {
  id         String   @id @default(cuid())
  sku        String   @unique
  name       String
  /// Integer paise. ₹1,899.00 = 189900
  pricePaise Int
  stock      Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  items      OrderItem[]

  @@index([active])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
  FULFILLED
}

model Order {
  id             String      @id @default(cuid())
  number         String      @unique
  status         OrderStatus @default(PENDING_PAYMENT)
  amountPaise    Int
  currency       String      @default("INR")
  customerName   String
  customerPhone  String
  /// Idempotency-Key ka SHA-256 — double click par double order nahi
  idempotencyKey String      @unique
  /// Payment link se aaya order ho to uska id (attribution ke liye)
  linkId         String?
  items          OrderItem[]
  sessions       PaymentSession[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status])
  @@index([customerPhone])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  sku            String
  name           String
  unitPricePaise Int
  qty            Int
  lineTotalPaise Int

  @@index([orderId])
  @@unique([orderId, productId])
}

// ---------------------------------------------------------------------------
// Payment sessions — har try ka apna single-use QR, ek VPA par ek ACTIVE slot
// ---------------------------------------------------------------------------

enum SessionStatus {
  QUEUED // slot ka wait (FIFO position ke saath)
  ACTIVE // QR live, buyer 5 min tak pay kar sakta hai
  PROCESSING // credit dikha, verification window chal raha hai
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  SUSPICIOUS // match nahi hua / ambiguous / verify timeout — manual review
}

model PaymentSession {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  merchantId      String
  merchant        MerchantAccount @relation(fields: [merchantId], references: [id])
  amountPaise     Int
  currency        String        @default("INR")
  status          SessionStatus @default(QUEUED)
  /// Order ka short reference — QR ke `tn` (transaction note) me jaata hai
  reference       String        @unique
  /// Poora `upi://pay?pa=...&am=...&tn=...` string (client ise render karta hai)
  upiString       String
  vpa             String
  /// FIFO order (badhne wala number; display position read ke waqt compute hoti hai)
  queuePosition   Int           @default(0)
  payExpiresAt    DateTime
  verifyExpiresAt DateTime?
  /// 12-digit UPI reference bank statement se
  utr             String?       @unique
  method          String?       @default("upi")
  senderVpa       String?
  failureReason   String?
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  observations BankObservation[]

  @@index([orderId])
  @@index([merchantId, status])
  @@index([status, payExpiresAt])
}

// ---------------------------------------------------------------------------
// Bank observations — observer (Android SMS / Gmail / Messages) se aayi entries
// ---------------------------------------------------------------------------

enum ObservationSource {
  ANDROID_SMS
  GMAIL
  MESSAGES
  MANUAL
}

enum ObservationStatus {
  RECEIVED
  MATCHED
  DUPLICATE
  UNMATCHED
  SUSPICIOUS
}

model BankObservation {
  id          String            @id @default(cuid())
  source      ObservationSource
  /// Observer device/app id (audit + trust ke liye)
  deviceId    String
  /// Observer-side unique id — same message dobara bheje to duplicate
  messageId   String
  rawText     String
  amountPaise Int
  /// 12-digit UPI UTR / RRN
  utr         String
  senderVpa   String?
  bankName    String?
  /// CREDIT hi accept hota hai (DEBIT ignore)
  direction   String            @default("CREDIT")
  observedAt  DateTime
  status      ObservationStatus @default(RECEIVED)
  sessionId   String?
  session     PaymentSession?   @relation(fields: [sessionId], references: [id])
  createdAt   DateTime          @default(now())

  @@unique([utr, amountPaise])
  @@unique([deviceId, messageId])
  @@index([sessionId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Outbound webhooks — merchant ke server ko signed delivery + retries
// ---------------------------------------------------------------------------

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model OutboundWebhook {
  id             String         @id @default(cuid())
  merchantId     String
  merchant       MerchantAccount @relation(fields: [merchantId], references: [id])
  event          String
  paymentId      String
  orderId        String
  /// Har delivery ka apna id — merchant isse dedupe karta hai
  deliveryId     String         @unique
  url            String
  payload        Json
  status         DeliveryStatus @default(PENDING)
  attempts       Int            @default(0)
  lastStatusCode Int?
  lastError      String?
  nextAttemptAt  DateTime
  createdAt      DateTime       @default(now())
  deliveredAt    DateTime?

  @@index([status, nextAttemptAt])
  @@index([paymentId])
}

// ---------------------------------------------------------------------------
// Settings — admin se badalne wali cheezein (VPA pending, open-link limits)
// ---------------------------------------------------------------------------

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Payment links — fixed amount ya open amount, token se public
// ---------------------------------------------------------------------------

enum PaymentLinkKind {
  FIXED
  OPEN
}

enum PaymentLinkStatus {
  ACTIVE
  DISABLED
}

model PaymentLink {
  id             String            @id @default(cuid())
  /// Public URL me jaane wala secret (`/pay/<token>`) — guess-proof
  token          String            @unique
  kind           PaymentLinkKind
  title          String
  /// UPI `tn` note
  note           String
  /// FIXED par locked amount (integer paise); OPEN par NULL
  amountPaise    Int?
  minAmountPaise Int?
  maxAmountPaise Int?
  status         PaymentLinkStatus  @default(ACTIVE)
  maxUses        Int               @default(1000)
  usedCount      Int               @default(0)
  expiresAt      DateTime?
  createdBy      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit log — append-only (DB trigger se UPDATE/DELETE block)
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actor     String
  action    String
  entity    String
  entityId  String?
  before    String?
  after     String?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}
