# Purpose: Saari environment variables ka template (asli keys yahan NAHI)
#
#   cp .env.example .env
#   cp .env.example apps/api/.env      # API yahi padhta hai
#
# Self-hosted UPI gateway — koi Razorpay/PayU nahi. Paisa aapke apne bank (VPA) me aata hai.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database (docker compose se same values)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://youpi:youpi@localhost:5432/youpi
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Gateway — aapka apna bank account
# ---------------------------------------------------------------------------
# Merchant ka UPI VPA: paisa seedha yahan aayega (e.g. yourstore@okhdfcbank)
MERCHANT_VPA=
MERCHANT_NAME=Demo Store
# QR me / bank app me dikhne wala payee naam
PAYEE_NAME=Demo Store

# Aapke server ka webhook URL (signed delivery yahan jaati hai; local ke liye ngrok)
MERCHANT_WEBHOOK_URL=
# HMAC secret (kam se kam 16 chars) — merchant side par isi se verify hoga
MERCHANT_WEBHOOK_SECRET=

# Observers (Android SMS app / Gmail watcher) ka shared secret
OBSERVER_SHARED_SECRET=

# Admin API token (POST /api/v1/admin/merchant)
ADMIN_API_TOKEN=

# Timers: pay window 5 min, verification window 30 s
PAY_WINDOW_SECONDS=300
VERIFY_WINDOW_SECONDS=30

# ---------------------------------------------------------------------------
# Phase 1 me aayenge
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SMTP_URL=
WHATSAPP_API_TOKEN=
