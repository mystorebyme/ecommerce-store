# Purpose: Saari environment variables ka template (asli keys yahan NAHI)
#
# Copy karo:  cp .env.example .env
# Local dev me `apps/api/.env` bhi banega (same values, API wahi padhta hai).

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Database + Redis (docker compose se same values)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://youpi:youpi@localhost:5432/youpi
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Razorpay (test mode se shuru karo — rzp_test_...)
# Dashboard → Account & Settings → API Keys | Webhooks
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment attempt TTL (seconds). UPI QR isi ke baad expire hota hai.
PAYMENT_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Storage / shipping / notifications (Phase 1 me use honge)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SMTP_URL=
WHATSAPP_API_TOKEN=
